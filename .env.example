# Flask
SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=development
FLASK_DEBUG=1

# Database
# For quick local demo, leave DATABASE_URL unset -> SQLite file guestsphere.db is used.
# For MySQL (production/full setup), uncomment and fill in:
# DATABASE_URL=mysql+pymysql://guestsphere_user:yourpassword@localhost:3306/guestsphere

# App
APP_NAME=GuestSphere
UPLOAD_FOLDER=uploads
FACE_DATA_FOLDER=face_data
MODELS_DATA_FOLDER=models_data

# Face recognition
FACE_RECOGNITION_CONFIDENCE_THRESHOLD=70

# QR
QR_SECRET_SALT=change-this-too
